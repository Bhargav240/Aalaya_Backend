# Copy to .env and fill in your Supabase Postgres connection string.
# Supabase -> Project Settings -> Database -> Connection string.
# Use the pooler (transaction mode) host on port 6543.
DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST]:6543/postgres
# Direct database URL or the Supabase session pooler (port 5432), used only
# for startup migrations. Do not point this at the transaction pooler.
MIGRATION_DATABASE_URL=
BIND_ADDR=0.0.0.0:8080
LOG_FORMAT=pretty
RUST_LOG=info,pg_api=debug,pg_infrastructure=debug

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in (OAuth 2.0 "aud" — the client ID issued for the Android app).
# Go to Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
# Leave blank to disable /auth/google in this deployment.
GOOGLE_CLIENT_ID=

# Email OTP provider. Use "log" locally; production uses "resend".
EMAIL_PROVIDER=log
# Development only: expose the login code in server logs. This is ignored by
# release builds even if accidentally enabled.
DEBUG_EMAIL_OTP=false
RESEND_API_KEY=
EMAIL_FROM="Aalaya <no-reply@example.com>"
PG_NAME="Aalaya"
# Base URL for invitation emails. A custom scheme like aalaya:// is NOT
# clickable in Gmail (it strips non-standard href schemes), so with the default
# below the email omits the link and routes the reader through the app's Invites
# tab instead. Point this at a verified https:// App Link to get a real button:
#   APP_DEEP_LINK_BASE=https://<your-domain>/onboarding
APP_DEEP_LINK_BASE=aalaya://onboarding
INVITATION_RESEND_COOLDOWN_SECS=60
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://127.0.0.1:8080/api/v1/integrations/digilocker/callback
DIGILOCKER_AUTHORIZATION_ENDPOINT=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_ENDPOINT=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_USERINFO_ENDPOINT=https://digilocker.meripehchaan.gov.in/public/oauth2/1/user
DIGILOCKER_SCOPES=openid
DIGILOCKER_SESSION_ENCRYPTION_KEY=
DIGILOCKER_SESSION_TTL_SECS=600

# Firebase Cloud Messaging: raw service-account JSON for the project.
# Leave blank in dev (notices just log).
FCM_SERVICE_ACCOUNT_JSON=

# The platform organization that owns platform_operator and prospect accounts.
# Migration 0009 seeds this default UUID with active pooled routing. If a
# deployment overrides the UUID, it must add an equivalent deployment-specific
# seed migration before accepting new Explorer sign-ins.
PLATFORM_ORG_ID=00000000-0000-0000-0000-000000000001

# Background jobs
VACANCY_INTERVAL_SECS=120
ARCHIVE_INTERVAL_SECS=86400
ARCHIVE_OLDER_THAN_DAYS=30
PROVISIONING_KEY=set-a-secret-to-enable-POST-/api/v1/orgs
ACCESS_TTL_SECS=900
REFRESH_TTL_SECS=1209600

# Deployment profile. `production` makes startup REFUSE unsafe config
# (default JWT secret, VERIFICATION_METHOD=mock, missing DATABASE_URL).
PROFILE=development

# Email OTP sign-in
OTP_TTL_SECS=600
OTP_RESEND_COOLDOWN_SECS=30
OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_SENDS=3
EMAIL_OTP_WINDOW_SECS=900

# Minimum notice (days) before a move-out keeps the deposit refundable.
MOVE_OUT_NOTICE_DAYS=30

# Object storage (receipts). Local dir in dev; swap adapter for Supabase/S3.
STORAGE_DIR=./data/objectstore

# Identity verification: default provider (mock | digilocker). Registry dispatches by method.
VERIFICATION_METHOD=mock

# Object storage backend: local | supabase
STORAGE_BACKEND=local
# For STORAGE_BACKEND=supabase (Storage -> S3-compatible; receipts get signed-URL downloads):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=receipts
RECEIPT_URL_TTL_SECS=300
